<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Request at runtime before the future real LAN connection UI on API 37+. Offline demo does not request it. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK"/>
    <uses-feature android:glEsVersion="0x00020000" android:required="true"/>
    <application android:label="Light Chase Skeleton" android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" android:allowBackup="false">
        <activity android:name=".AndroidLauncher" android:exported="true" android:screenOrientation="landscape" android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
    </application>
</manifest>
